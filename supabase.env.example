# Public Supabase settings bundled into the app. Copy to supabase.env and
# fill in from Supabase dashboard → Project Settings → API. Only the URL
# and the anon/publishable key belong here: anything in this file ships
# inside the APK. Server-side keys go in Edge Function secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
